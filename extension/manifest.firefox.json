{
  "manifest_version": 3,
  "name": "Game Club \u2014 Ludo & Snakes n Ladders",
  "short_name": "Game Club",
  "description": "Play Ludo and Snakes & Ladders offline \u2014 2-10 players, smart bots, pass-and-play.",
  "version": "1.2.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Game Club",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://ludo-1zpb.onrender.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://ludo-1zpb.onrender.com"
  },
  "offline_enabled": true,
  "browser_specific_settings": {
    "gecko": {
      "id": "game-club@ludo-snails.example",
      "strict_min_version": "115.0"
    }
  }
}
