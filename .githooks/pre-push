#!/usr/bin/env bash
# Pre-push: the free local gate.
#
# Enable once per clone with:
#     git config core.hooksPath .githooks
#
# This runs analyze + test. It does NOT touch CHANGELOG.md: that is generated by
# the CI changelog job on push, and doing it in both places made the two race -
# whichever ran second produced a commit the other had not verified.
set -uo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

skip() { printf '\033[33m[pre-push] %s\033[0m\n' "$1"; exit 0; }

# 1. The local quality gate, unless this push only moves tags or deletes refs.
#
# Ref *deletions* arrive as ":refs/heads/x" with an empty local side. Running
# the suite on one is pure waste - a deleted branch changes no code - and it
# blocked a routine cleanup outright.
pushing_refs=()
deleting=0
for remote_ref in "$@"; do
  case "$remote_ref" in
    refs/tags/*) ;;
    :*) deleting=1 ;;
    *) pushing_refs+=("$remote_ref") ;;
  esac
done
[ ${#pushing_refs[@]} -eq 0 ] && skip "tag-only or delete-only push, nothing to check."
[ "$deleting" = 1 ] && {
  printf '\033[1m[pre-push] deleting refs; skipping the gate\033[0m\n'
  exit 0
}

if [ "${SKIP_LOCAL_CI:-0}" = "1" ]; then
  skip "SKIP_LOCAL_CI=1 — skipping analyze/test."
fi

printf '\033[1m[pre-push] running local checks (analyze + test)\033[0m\n'
if ! tool/ci.sh; then
  printf '\n\033[31m[pre-push] blocked: local checks failed.\033[0m\n' >&2
  echo "  Fix and push again, or bypass deliberately with --no-verify." >&2
  echo "  CI is over its runner-minute quota, so this hook is currently the" >&2
  echo "  only automated check — bypassing it means nothing verifies the push." >&2
  exit 1
fi

printf '\033[32m[pre-push] ok\033[0m\n'
