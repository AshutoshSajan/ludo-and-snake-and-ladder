# Game Club server + client configuration.
#
# Copy to .env (gitignored) and fill in your values — the server reads it
# from its working directory at startup. On Render, set these as service
# environment variables instead (the dashboard wins over any file).
#
# --- Turso (all server data) ----------------------------------------------
# Create with:  turso db create <name>  /  turso db tokens create <name>
# When both are set, Turso is the single store of record: leaderboard,
# admin history, accounts/sessions, feedback, friends and the room registry.
# Without them the server falls back to one local SQLite file.
TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
TURSO_AUTH_TOKEN=your-database-token

# How long a room code stays routable after its instance's last refresh
# (seconds). Crashed replicas stop refreshing, so their entries self-expire.
ROOM_TTL_SECONDS=120

# --- Server -----------------------------------------------------------------
# Render's docker runtime injects PORT (default 10000); leave it empty for
# plain `dart run bin/server.dart`, which defaults to 8080.
# PORT=8080
# This replica's id in the room registry (also settable via --instance-id).
# INSTANCE_ID=game-1

# Whose forwarding chains rate-limit buckets may trust (CWE-307):
# comma-separated exact proxy addresses, nothing else. Requests arriving
# from any other socket key on themselves and ignore X-Forwarded-For
# altogether, so a client cannot forge or bystanders cannot hijack an
# identity. The default covers deploy/nginx.conf (same-host Nginx on a
# loopback backend leg); listing an outer proxy's backend address lets
# the walk see through its hop. Setting the variable REPLACES that
# default wholesale, so the value must still name every hop in the chain
# — the loopback pair 127.0.0.1 and ::1 included (the shipped Nginx leg
# is loopback), plus each additional proxy's backend-facing address,
# e.g. `TRUSTED_PROXIES=127.0.0.1,::1,10.8.0.7` — or the proxy hop the
# client actually arrives through is untrusted and every identity
# collapses onto the shared socket key again. Leave unset when the
# server faces clients directly (no proxy in the chain).
# TRUSTED_PROXIES=127.0.0.1,::1

# Where a Flutter web build is served from alongside the API
# (`flutter build web`); leave unset to skip static serving entirely.
# WEB_DIR=build/web

# --- Admin dashboard -------------------------------------------------------
# Interactive logins use email+password accounts stored in the same SQLite
# DB (auth_users/auth_sessions tables). ADMIN_TOKEN below is now two things:
#   1. the one-time setup secret: creating the FIRST admin at /admin
#      always requires it (fail closed — empty token disables setup, so a
#      fresh deploy cannot be claimed by whoever reaches /admin first);
#   2. a legacy service token: scripts bearing it keep working on /admin/*
#      without a login (audited as 'admin-token').
# Always set it, including local dev — there is no open first-run setup.
# Generate with:  openssl rand -hex 32
# ADMIN_TOKEN=change-me-to-a-long-random-value

# How long an admin session lasts, in whole hours, counted from sign-in.
# Every session row and every HttpOnly cookie derives from this one value;
# the server refuses to boot on a garbage value (0, negative, decimal,
# text) rather than silently stretching or shortening the window. Unset
# runs the 2-hour default.
# ADMIN_SESSION_TTL_HOURS=2

# --- Chat GIFs ---------------------------------------------------------------
# The GIF provider behind the picker's search box: clients ask this server's
# /media/gif, and only the server ever holds the key (a key baked into a web
# build is public). Klipy is the default provider (lifetime-free tier:
# https://partner.klipy.com — create a platform, copy its API key). GIPHY also
# works: beta keys are free but rate-capped (https://developers.giphy.com).
# GIF_PROVIDER optionally pins one (klipy|giphy); otherwise the first
# configured key wins, Klipy first.
# Without any key the picker degrades to the paste-a-link path; chat GIF
# sharing still works, only in-app search does not.
# GIF_PROVIDER=klipy
# KLIPY_API_KEY=
# GIPHY_API_KEY=
