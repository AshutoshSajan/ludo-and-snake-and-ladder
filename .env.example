# Game Club server + client configuration.
#
# Copy to .env (gitignored) and fill in your values — the server reads it
# from its working directory at startup. On Render, set these as service
# environment variables instead (the dashboard wins over any file).
#
# --- Turso (leaderboard + cross-instance room registry) ---------------------
# Create with:  turso db create <name>  /  turso db tokens create <name>
TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
TURSO_AUTH_TOKEN=your-database-token

# How long a room code stays routable after its instance's last refresh
# (seconds). Crashed replicas stop refreshing, so their entries self-expire.
ROOM_TTL_SECONDS=120

# --- Server -----------------------------------------------------------------
# Render's docker runtime injects PORT (default 10000); leave it empty for
# plain `dart run bin/server.dart`, which defaults to 8080.
# PORT=8080
# This replica's id in the room registry (also settable via --instance-id).
# INSTANCE_ID=game-1

# Where a Flutter web build is served from alongside the API
# (`flutter build web`); leave unset to skip static serving entirely.
# WEB_DIR=build/web
